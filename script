// ==UserScript==
// @name         Twitch Emote No-Restart
// @namespace    twitch-emote-no-restart
// @version      1.9.4
// @description  Prevents animated Twitch/7TV/BTTV/FFZ chat emotes from restarting/flickering when a new instance of the same emote is posted. All on-screen copies of an emote share one animation clock.
// @author       Sirsane2k
// @license      GNU GPLv3
// @match        https://www.twitch.tv/*
// @run-at       document-idle
// @grant        GM_xmlhttpRequest
// @connect      static-cdn.jtvnw.net
// @connect      cdn.7tv.app
// @connect      cdn.7tv.io
// @connect      cdn.betterttv.net
// @connect      cdn.frankerfacez.com
// @homepageURL  https://github.com/deadnme/Twitch-Emote-No-Restart
// ==/UserScript==
 
(function () {
  'use strict';
 
  const CLEANUP_DELAY_MS = 15000;      // how long to keep a decoded emote cached with no visible instances
  const OCCLUSION_REFRESH_MS = 200;    // idle occlusion sampling cadence
  const OCCLUSION_DIRTY_MIN_INTERVAL_MS = 100; // fastest we'll re-sample when a UI event marked the cache dirty
  const OCCLUSION_SAMPLES = 5;
  const OCCLUSION_EDGE_INSET = 0.08;   // keep samples off the exact top/bottom edge to dodge row-seam false positives
 
  const URL_PATTERNS = [
    { name: 'twitch', re: /static-cdn\.jtvnw\.net\/emoticons\/v2\/([^/]+)\// },
    { name: '7tv', re: /cdn\.7tv\.(?:app|io)\/emote\/([^/]+)/ },
    { name: 'bttv', re: /cdn\.betterttv\.net\/emote\/([^/]+)/ },
    { name: 'ffz', re: /cdn\.frankerfacez\.com\/(?:emote|emoticon)\/(\d+)/ },
  ];
 
  const STATE_MAP = new Map();   // emote key -> shared decoded animation state
  const INSTANCES = new Map();   // <img> -> per-instance overlay/canvas bookkeeping
  let overlayLayer = null;
 
  function ensureOverlayLayer() {
    if (overlayLayer && document.body.contains(overlayLayer)) return overlayLayer;
    overlayLayer = document.createElement('div');
    overlayLayer.id = 'tenr-overlay-layer';
    Object.assign(overlayLayer.style, {
      position: 'fixed', top: '0', left: '0', width: '0', height: '0',
      overflow: 'visible', pointerEvents: 'none',
      // Modest z-index: high enough to sit above chat rows, low enough to
      // stay *under* Twitch's own emote hover preview / tooltip layer.
      // The previous value (2147483647) put every canvas above every
      // tooltip, so the hover preview was rendering beneath existing
      // emotes. If a future Twitch UI change ever puts tooltips below 100,
      // drop this further.
      zIndex: '100',
    });
    document.body.appendChild(overlayLayer);
    return overlayLayer;
  }
 
  // Twitch renders its hover preview (the big emote + "Emote: X / Channel
  // Emotes / By: Y" card you get when mousing over a chat emote) as a fresh
  // <img> inside a tooltip-layer portal, sitting at a very high z-index
  // above our overlay. If we attached to that <img> we'd set opacity:0 on
  // it (hiding Twitch's own preview image) and draw a replacement canvas
  // into our layer — but our layer is *below* the tooltip, so the canvas
  // would be invisible behind the tooltip's background. Net result:
  // tooltip text with a blank emote slot.
  //
  // We detect any ancestor that looks like a Twitch tooltip / hover-card /
  // popover and refuse to attach there. The check is a parent chain walk
  // with attribute sniffing; Twitch's own class names change over time, so
  // we look at role/data-* attributes (more stable) and fall back to a
  // substring match on className.
  function isInTooltip(el) {
    let node = el.parentElement;
    while (node && node !== document.body && node.nodeType === 1) {
      const role = node.getAttribute && node.getAttribute('role');
      if (role === 'tooltip') return true;
 
      const dt = (node.getAttribute && node.getAttribute('data-a-target')) || '';
      if (dt.indexOf('tooltip') !== -1) return true;
 
      const ts = (node.getAttribute && node.getAttribute('data-test-selector')) || '';
      if (ts.toLowerCase().indexOf('tooltip') !== -1) return true;
 
      const cls = node.className;
      if (typeof cls === 'string' && cls) {
        const lower = cls.toLowerCase();
        if (lower.indexOf('tooltip') !== -1 ||
            lower.indexOf('hover-card') !== -1 ||
            lower.indexOf('hovercard') !== -1 ||
            lower.indexOf('popover') !== -1) {
          return true;
        }
      }
      node = node.parentElement;
    }
    return false;
  }
 
  // ---- URL helpers --------------------------------------------------
 
  const keyForUrl = (url) => {
    for (const { name, re } of URL_PATTERNS) {
      const m = url.match(re);
      if (m) return `${name}:${m[1]}`;
    }
    return null;
  };
 
  const isCandidateUrl = (url) => !!url && URL_PATTERNS.some(({ re }) => re.test(url));
 
  function bestUrlFor(imgEl) {
    // Read the srcset/src *attributes* first — they update synchronously
    // with the DOM mutation that fires our MutationObserver. imgEl.currentSrc
    // is the browser's own async-resolved "which responsive candidate did I
    // pick" property and can lag a frame behind on a recycled <img> node,
    // which was causing us to miss an emote swap (stale key -> wrong cached
    // animation kept showing, while Twitch's own tooltip — reading
    // attributes directly — correctly reported the new emote's real name).
    const srcset = imgEl.getAttribute('srcset');
    if (srcset) {
      const candidates = srcset.split(',').map((s) => s.trim().split(/\s+/)[0]).filter(isCandidateUrl);
      if (candidates.length) return candidates[candidates.length - 1];
    }
    const srcAttr = imgEl.getAttribute('src');
    if (isCandidateUrl(srcAttr)) return srcAttr;
    if (isCandidateUrl(imgEl.currentSrc)) return imgEl.currentSrc;
    if (isCandidateUrl(imgEl.src)) return imgEl.src;
    return null;
  }
 
  // Live key = the key the DOM *currently* says this <img> should represent.
  // Used both at attach time and, defensively, every animation frame so a
  // swap that our MutationObserver failed to notice can never leave a stale
  // cached emote on screen.
  function liveKeyFor(imgEl) {
    const url = bestUrlFor(imgEl);
    return url ? keyForUrl(url) : null;
  }
 
  function guessMimeType(url) {
    if (/\.webp(\?|$)/i.test(url)) return 'image/webp';
    if (/\.gif(\?|$)/i.test(url)) return 'image/gif';
    if (/\.png(\?|$)/i.test(url)) return 'image/png';
    return 'image/webp';
  }
 
  // Every instance of an emote shares one decode, so always fetch the
  // largest known size variant for the provider — otherwise whichever
  // <img> (e.g. a small inline chat image) happens to trigger the decode
  // first would leave every other instance, including Twitch's own
  // enlarged hover preview, stuck showing an upscaled/blurry bitmap.
  function upgradeToHighestQuality(url) {
    let m = url.match(/^(https:\/\/static-cdn\.jtvnw\.net\/emoticons\/v2\/[^/]+\/[^/]+\/[^/]+\/)[\d.]+$/);
    if (m) return m[1] + '3.0';
    m = url.match(/^(https:\/\/cdn\.7tv\.(?:app|io)\/emote\/[^/]+\/)\d+x(\.\w+)?$/);
    if (m) return m[1] + '4x' + (m[2] || '');
    // BTTV can serve size variants with a file extension in the URL, e.g.
    // https://cdn.betterttv.net/emote/{id}/2x.webp. The old regex anchored
    // `$` right after `\d+x`, so any extension form silently failed to
    // match and stayed at whatever low-res size the DOM happened to give us.
    m = url.match(/^(https:\/\/cdn\.betterttv\.net\/emote\/[^/]+\/)\d+x(\.\w+)?$/);
    if (m) return m[1] + '3x' + (m[2] || '');
    m = url.match(/^(https:\/\/cdn\.frankerfacez\.com\/(?:emote|emoticon)\/[^/]+\/)\d+(\.\w+)?$/);
    if (m) return m[1] + '4' + (m[2] || '');
    return url;
  }
 
  // ---- Fetch + decode -------------------------------------------------
 
  function fetchArrayBuffer(url) {
    return fetch(url, { mode: 'cors', credentials: 'omit' })
      .then((resp) => {
        if (!resp.ok) throw new Error('bad status ' + resp.status);
        const type = resp.headers.get('content-type') || guessMimeType(url);
        return resp.arrayBuffer().then((buf) => ({ buf, type }));
      })
      .catch(() => {
        if (typeof GM_xmlhttpRequest !== 'function') throw new Error('no GM fallback');
        return new Promise((resolve, reject) => {
          GM_xmlhttpRequest({
            method: 'GET', url, responseType: 'arraybuffer',
            onload: (res) => {
              if (res.status < 200 || res.status >= 300) return reject(new Error('GM status ' + res.status));
              const ct = (res.responseHeaders || '').match(/content-type:\s*([^\r\n;]+)/i);
              resolve({ buf: res.response, type: ct ? ct[1].trim() : guessMimeType(url) });
            },
            onerror: reject,
          });
        });
      });
  }
 
  function createState(key, url) {
    const state = {
      key, url, frames: null, totalDuration: 0, startTime: performance.now(),
      loading: true, failed: false, staticOnly: false, refCount: 0, cleanupTimer: null,
    };
    STATE_MAP.set(key, state);
    decodeInto(state);
    return state;
  }
 
  async function decodeInto(state) {
    try {
      if (typeof ImageDecoder === 'undefined') {
        state.failed = true; state.loading = false; return;
      }
      const { buf, type } = await fetchArrayBuffer(state.url);
      const decoder = new ImageDecoder({ data: buf, type });
      await decoder.tracks.ready;
      const frameCount = (decoder.tracks.selectedTrack && decoder.tracks.selectedTrack.frameCount) || 1;
 
      if (frameCount <= 1) {
        state.staticOnly = true; state.loading = false;
        if (decoder.close) decoder.close();
        return;
      }
 
      const frames = [];
      let total = 0;
      for (let i = 0; i < frameCount; i++) {
        const { image } = await decoder.decode({ frameIndex: i });
        const durationMs = image.duration ? image.duration / 1000 : 100;
        // VideoFrame -> ImageBitmap avoids the pink/white diagonal
        // corruption some animated WebP/GIFs show when drawn directly.
        let bitmap;
        try { bitmap = await createImageBitmap(image); } finally { image.close(); }
        frames.push({ bitmap, duration: durationMs });
        total += durationMs;
      }
 
      if (STATE_MAP.get(state.key) !== state) {
        frames.forEach((f) => f.bitmap.close && f.bitmap.close());
        return;
      }
      state.frames = frames;
      state.totalDuration = total || 1;
      state.startTime = performance.now(); // shared epoch, set exactly once — never touched again
      state.loading = false;
      if (decoder.close) decoder.close();
    } catch (e) {
      state.failed = true; state.loading = false;
    }
  }
 
  function acquireState(key, url) {
    const state = STATE_MAP.get(key) || createState(key, url);
    if (state.cleanupTimer) { clearTimeout(state.cleanupTimer); state.cleanupTimer = null; }
    state.refCount++;
    return state;
  }
 
  function releaseState(key) {
    const state = STATE_MAP.get(key);
    if (!state) return;
    state.refCount = Math.max(0, state.refCount - 1);
    if (state.refCount !== 0) return;
    state.cleanupTimer = setTimeout(() => {
      if (STATE_MAP.get(key) === state && state.refCount === 0) {
        if (state.frames) state.frames.forEach((f) => f.bitmap.close && f.bitmap.close());
        STATE_MAP.delete(key);
      }
    }, CLEANUP_DELAY_MS);
  }
 
  // ---- Per-<img> instances -------------------------------------------
 
  function attachInstance(imgEl) {
    if (INSTANCES.has(imgEl)) return;
    // Never attach to a hover-preview / popover emote. See isInTooltip().
    if (isInTooltip(imgEl)) return;
    const url = bestUrlFor(imgEl);
    const key = url && keyForUrl(url);
    if (!key) return;
 
    const canvas = document.createElement('canvas');
    canvas.className = 'tenr-canvas';
    Object.assign(canvas.style, { position: 'fixed', top: '0', left: '0', pointerEvents: 'none', display: 'none' });
    // Configure the 2d context once, up front. imageSmoothingQuality defaults
    // to 'low', which was visibly softening every downscaled emote; 'high'
    // selects a better filter (matching what <img> uses for its own resize).
    const ctx = canvas.getContext('2d');
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ensureOverlayLayer().appendChild(canvas);
 
    // occlusionInsets semantics:
    //   undefined  = not yet computed; tick draws with no occlusion and
    //                the throttled refresh populates real values within
    //                ~200ms. New chat messages appear at the bottom of
    //                the chat list, where occlusion is essentially always
    //                {0,0}, so the brief default is visually identical to
    //                the correct answer — and skipping the synchronous
    //                findScrollClipAncestor + elementFromPoint×5 walk on
    //                first tick is what removes the ~200ms hitch after
    //                typing an emote.
    //   null       = fully occluded (hide).
    //   {top,bottom} px = partial crop from those edges.
    // clipAncestor / rowRoot: cached lazily by the throttled refresh only,
    // never in the tick loop, so the tick is free of layout-forcing work.
    INSTANCES.set(imgEl, {
      canvas, ctx, key, hidden: false,
      clipAncestor: undefined, rowRoot: undefined, occlusionInsets: undefined,
      bmpW: 0, bmpH: 0,
      // Last-seen srcset/src attribute values, so per-tick live-key
      // verification can skip the regex work entirely on frames where the
      // DOM hasn't changed (the common case for a stable chat).
      lastSrcset: undefined, lastSrc: undefined,
    });
    // acquireState reuses an existing shared state untouched if one already
    // exists for this key — never re-decodes, never resets startTime, never
    // disturbs any other instance already animating. That's the core fix.
    acquireState(key, upgradeToHighestQuality(url));
  }
 
  function detachInstance(imgEl) {
    const inst = INSTANCES.get(imgEl);
    if (!inst) return;
    inst.canvas.remove();
    INSTANCES.delete(imgEl);
    releaseState(inst.key);
    if (inst.hidden) imgEl.style.opacity = '';
  }
 
  // Nearest genuinely-scrollable ancestor (the chat message list itself).
  // Only overflowY auto/scroll counts — plain overflow:hidden is far too
  // common for unrelated reasons (text truncation, rounded corners) and
  // would grab some small inner wrapper, clipping emotes down to it.
  function findScrollClipAncestor(el) {
    let node = el.parentElement;
    while (node && node !== document.documentElement) {
      const cs = getComputedStyle(node);
      if ((cs.overflowY === 'auto' || cs.overflowY === 'scroll') && node.scrollHeight > node.clientHeight + 1 && node.clientHeight >= 120) {
        return node;
      }
      node = node.parentElement;
    }
    return null;
  }
 
  // The top-level child of clipAncestor that contains imgEl — i.e. "this
  // chat message's own DOM subtree". Anything Twitch draws inside it
  // (hover highlight, reply button, badges) is not occlusion; anything
  // outside it (Predict panel, pinned banner, sticky header) is.
  function findRowRoot(imgEl, clipAncestor) {
    if (!clipAncestor) return null;
    let node = imgEl;
    while (node.parentElement && node.parentElement !== clipAncestor) node = node.parentElement;
    return node.parentElement === clipAncestor ? node : null;
  }
 
  // ---- DOM scanning ----------------------------------------------------
 
  function maybeAttach(imgEl) {
    if (isInTooltip(imgEl)) return;
    const url = bestUrlFor(imgEl);
    if (url && keyForUrl(url)) attachInstance(imgEl);
  }
 
  function scanNode(node) {
    if (!(node instanceof Element)) return;
    if (node.tagName === 'IMG') maybeAttach(node);
    node.querySelectorAll && node.querySelectorAll('img').forEach(maybeAttach);
  }
 
  function startObserving() {
    new MutationObserver((mutations) => {
      for (const m of mutations) {
        m.addedNodes && m.addedNodes.forEach(scanNode);
        m.removedNodes && m.removedNodes.forEach((node) => {
          if (!(node instanceof Element)) return;
          if (node.tagName === 'IMG' && INSTANCES.has(node)) detachInstance(node);
          INSTANCES.forEach((inst, imgEl) => { if (node.contains(imgEl)) detachInstance(imgEl); });
        });
        if (m.type === 'attributes' && m.target instanceof HTMLImageElement) {
          // Twitch sometimes recycles an <img> node in place (new src/srcset).
          // bestUrlFor reads the src/srcset *attributes* (not currentSrc),
          // which are guaranteed to be the new values by the time this
          // callback runs — so the key we derive here matches what the
          // tooltip will read on hover.
          const imgEl = m.target;
          const existing = INSTANCES.get(imgEl);
          const newKey = liveKeyFor(imgEl);
          if (existing && (!newKey || existing.key !== newKey)) detachInstance(imgEl);
          if (newKey && (!existing || existing.key !== newKey)) attachInstance(imgEl);
        }
      }
    }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['src', 'srcset'] });
  }
 
  // ---- Shared animation clock ------------------------------------------
 
  function currentFrameIndex(state, now) {
    const elapsed = (now - state.startTime) % state.totalDuration;
    let acc = 0;
    for (let i = 0; i < state.frames.length; i++) {
      acc += state.frames[i].duration;
      if (elapsed < acc) return i;
    }
    return state.frames.length - 1;
  }
 
  // ---- Throttled occlusion (partial-crop, not a boolean) ---------------
  //
  // Samples a handful of points down the emote's rect. Returns how much to
  // inset from the top/bottom, not just whether "most" of it is covered —
  // a majority-vote boolean was letting emotes draw in full over a banner
  // whenever less than half the sample points were covered.
  //
  // Runs *only* here, never in the tick loop: findScrollClipAncestor +
  // findRowRoot + elementFromPoint are all layout-sensitive, and doing them
  // synchronously for a brand-new instance inside tick is what caused the
  // ~200ms lag after typing an emote.
 
  function computeOcclusionInsets(imgEl, rowRoot, rect) {
    const vw = window.innerWidth, vh = window.innerHeight;
    const x = rect.left + rect.width / 2;
    if (x < 0 || x >= vw) return { top: 0, bottom: 0 };
 
    const boundary = rowRoot || imgEl;
    let visTop = null, visBottom = null;
    for (let i = 0; i < OCCLUSION_SAMPLES; i++) {
      const frac = OCCLUSION_EDGE_INSET + (1 - 2 * OCCLUSION_EDGE_INSET) * (i / (OCCLUSION_SAMPLES - 1));
      const y = rect.top + rect.height * frac;
      if (y < 0 || y >= vh) continue;
      const hit = document.elementFromPoint(x, y);
      const visible = !!hit && (boundary === hit || boundary.contains(hit) || hit.contains(boundary));
      if (visible) { if (visTop === null) visTop = y; visBottom = y; }
    }
    if (visTop === null) return null; // fully occluded
    return { top: Math.max(0, visTop - rect.top), bottom: Math.max(0, rect.bottom - visBottom) };
  }
 
  let lastOcclusionCheck = -Infinity;
  let occlusionDirty = false;
  function markOcclusionDirty() { occlusionDirty = true; }
 
  function updateOcclusion(now) {
    // Idle refresh is throttled to OCCLUSION_REFRESH_MS. UI events that
    // almost always change occlusion (pinned banner expand/collapse,
    // window resize, hover tooltip transitions) set occlusionDirty, which
    // lets the next pass bypass the idle throttle but still caps how
    // often we'll do the expensive walk at OCCLUSION_DIRTY_MIN_INTERVAL_MS.
    const minInterval = occlusionDirty ? OCCLUSION_DIRTY_MIN_INTERVAL_MS : OCCLUSION_REFRESH_MS;
    if (now - lastOcclusionCheck < minInterval) return;
    occlusionDirty = false;
    lastOcclusionCheck = now;
    const vw = window.innerWidth, vh = window.innerHeight;
 
    for (const [imgEl, inst] of INSTANCES) {
      if (!document.body.contains(imgEl)) continue;
      const rect = imgEl.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) { inst.occlusionInsets = null; continue; }
      if (rect.bottom < 0 || rect.top > vh || rect.right < 0 || rect.left > vw) { inst.occlusionInsets = { top: 0, bottom: 0 }; continue; }
 
      // Cache the clip ancestor / row root once. If we cached null (no
      // scroll ancestor found), keep null — re-walking the parent chain
      // every refresh was measurable cost on chats with many visible
      // instances. The only trade-off is that an initially non-scrollable
      // chat that later gains a scroll container won't pick it up until
      // the instance is reattached, which in practice is a non-issue
      // because Twitch's chat list is scrollable from the start.
      if (inst.clipAncestor === undefined) {
        inst.clipAncestor = findScrollClipAncestor(imgEl);
      } else if (inst.clipAncestor && !document.body.contains(inst.clipAncestor)) {
        inst.clipAncestor = findScrollClipAncestor(imgEl);
      }
      if (inst.rowRoot === undefined) {
        inst.rowRoot = findRowRoot(imgEl, inst.clipAncestor);
      } else if (inst.rowRoot && !document.body.contains(inst.rowRoot)) {
        inst.rowRoot = findRowRoot(imgEl, inst.clipAncestor);
      }
 
      inst.occlusionInsets = computeOcclusionInsets(imgEl, inst.rowRoot, rect);
    }
  }
 
  // Combines the scroll-ancestor clip with the occlusion insets into one
  // CSS clip-path, or null if nothing would remain visible.
  function computeClipPath(rect, cRect, occlusionInsets) {
    let top = 0, left = 0, right = 0, bottom = 0;
    if (cRect) {
      top = Math.max(top, cRect.top - rect.top);
      left = Math.max(left, cRect.left - rect.left);
      right = Math.max(right, rect.right - cRect.right);
      bottom = Math.max(bottom, rect.bottom - cRect.bottom);
    }
    if (occlusionInsets) {
      top = Math.max(top, occlusionInsets.top);
      bottom = Math.max(bottom, occlusionInsets.bottom);
    }
    if (top + bottom >= rect.height - 0.5 || left + right >= rect.width - 0.5) return null;
    if (!top && !right && !bottom && !left) return 'none';
    return `inset(${top}px ${right}px ${bottom}px ${left}px)`;
  }
 
  // ---- Render loop -------------------------------------------------------
 
  function tick() {
    const now = performance.now();
    updateOcclusion(now);
    const vw = window.innerWidth, vh = window.innerHeight;
 
    // Phase 1 (read-only): batch every getBoundingClientRect() so the
    // browser does one layout pass instead of thrashing between reads and
    // the style writes in phase 2.
    const work = [];
    for (const [imgEl, inst] of INSTANCES) {
      if (!document.body.contains(imgEl)) { work.push({ inst, imgEl, action: 'detach' }); continue; }
 
      // If this <img> has migrated into a tooltip/hover-card/popover — e.g.
      // Twitch moved an already-observed node, or our initial isInTooltip
      // check missed on the first frame the node existed — hand it back to
      // Twitch. Drawing a canvas over the tooltip's <img> would hide the
      // real preview image, and our canvas (z-index 100) is behind the
      // tooltip layer anyway, so nothing would replace it.
      if (isInTooltip(imgEl)) { work.push({ inst, imgEl, action: 'detach' }); continue; }
 
      // Cheap live-key verification: only do the regex/URL work if the
      // srcset or src attribute actually changed since the last tick.
      // The MutationObserver handles the common swap case, but Twitch's
      // chat virtualization occasionally mutates src/srcset in a way that
      // slips past an attribute-filtered observer, and if we ever miss
      // one the canvas would keep drawing the stale emote while the
      // tooltip reports the new one. Comparing the raw attribute strings
      // is far cheaper than running bestUrlFor every frame for every
      // instance, and is exactly as reliable.
      const ss = imgEl.getAttribute('srcset');
      const sa = imgEl.getAttribute('src');
      if (ss !== inst.lastSrcset || sa !== inst.lastSrc) {
        inst.lastSrcset = ss;
        inst.lastSrc = sa;
        const liveKey = liveKeyFor(imgEl);
        if (liveKey && liveKey !== inst.key) {
          work.push({ inst, imgEl, action: 'reattach' });
          continue;
        }
      }
 
      const state = STATE_MAP.get(inst.key);
      if (!state || state.loading || state.failed) { work.push({ inst, imgEl, action: 'hide' }); continue; }
      if (state.staticOnly) { work.push({ inst, imgEl, action: 'restore' }); continue; } // not animated after all — hand back to Twitch's own <img>
 
      const rect = imgEl.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) { work.push({ inst, imgEl, action: 'hide' }); continue; }
      if (rect.bottom < 0 || rect.top > vh || rect.right < 0 || rect.left > vw) { work.push({ inst, imgEl, action: 'hide' }); continue; }
 
      // occlusions default: if the throttled refresh hasn't computed this
      // instance's occlusion yet (fresh attach, or first frame after a
      // reattach), draw with no occlusion. Correctness on the very first
      // visible frame was already guaranteed by the fact that brand-new
      // chat messages appear at the bottom of the list where occlusion
      // is effectively always zero.
      const insets = inst.occlusionInsets === undefined ? { top: 0, bottom: 0 } : inst.occlusionInsets;
      if (insets === null) { work.push({ inst, imgEl, action: 'hide' }); continue; }
 
      // cRect is null when no scroll ancestor was found, or when the cache
      // hasn't been populated yet — in both cases we simply don't apply a
      // scroll clip this frame.
      const cRect = (inst.clipAncestor && document.body.contains(inst.clipAncestor))
        ? inst.clipAncestor.getBoundingClientRect() : null;
      const clipPath = computeClipPath(rect, cRect, insets);
      if (clipPath === null) { work.push({ inst, imgEl, action: 'hide' }); continue; }
 
      work.push({ inst, imgEl, action: 'draw', rect, clipPath, state, now });
    }
 
    // Phase 2 (write-only).
    for (const { inst, imgEl, action, rect, clipPath, state, now: frameNow } of work) {
      if (action === 'detach') { detachInstance(imgEl); continue; }
 
      if (action === 'reattach') {
        // DOM currently advertises a different emote than the one our
        // canvas is drawing. Drop the stale binding (restoring the <img>
        // opacity on the way out) and re-bind to the live key. Because
        // attachInstance reuses the shared STATE_MAP entry, this does not
        // re-decode anything and does not disturb the animation clock of
        // any other instance of either emote.
        detachInstance(imgEl);
        attachInstance(imgEl);
        continue;
      }
 
      if (action === 'hide') {
        if (inst.canvas.style.display !== 'none') inst.canvas.style.display = 'none';
        continue;
      }
 
      if (action === 'restore') {
        if (inst.canvas.style.display !== 'none') inst.canvas.style.display = 'none';
        if (inst.hidden) { imgEl.style.opacity = ''; inst.hidden = false; }
        continue;
      }
 
      // action === 'draw'
      const canvas = inst.canvas;
      if (!inst.hidden) {
        // opacity, not visibility: visibility:hidden pulls the element out
        // of hit-testing, which breaks Twitch's own hover tooltip/click.
        imgEl.style.opacity = '0';
        inst.hidden = true;
      }
 
      // Canvas element size = the emote's CSS box (clip-path, transform,
      // hit-testing all operate in this space).
      canvas.style.transform = `translate3d(${rect.left}px, ${rect.top}px, 0)`;
      const wPx = rect.width + 'px', hPx = rect.height + 'px';
      if (canvas.style.width !== wPx) canvas.style.width = wPx;
      if (canvas.style.height !== hPx) canvas.style.height = hPx;
      if (canvas.style.clipPath !== clipPath) canvas.style.clipPath = clipPath;
 
      const frame = state.frames[currentFrameIndex(state, frameNow)].bitmap;
 
      // Backing store = the bitmap's *native* pixel dimensions, and draw
      // the frame 1:1. The browser then downscales the canvas to the CSS
      // display size using the same high-quality resampler it uses for
      // <img>. The previous approach sized the backing store to the
      // display size and let drawImage do a single-step bilinear shrink
      // from (e.g.) 128px down to 28px, which was noticeably softer than
      // native rendering. Bonus: drawImage is now a fast 1:1 blit.
      const bmpW = frame.width, bmpH = frame.height;
      if (inst.bmpW !== bmpW || inst.bmpH !== bmpH) {
        canvas.width = bmpW;
        canvas.height = bmpH;
        inst.bmpW = bmpW;
        inst.bmpH = bmpH;
      }
 
      const ctx = inst.ctx;
      ctx.clearRect(0, 0, bmpW, bmpH);
      try {
        ctx.drawImage(frame, 0, 0);
        if (canvas.style.display !== '') canvas.style.display = '';
      } catch (e) {
        // Never show a garbled frame — skip this tick, retry next one.
        if (canvas.style.display !== 'none') canvas.style.display = 'none';
      }
    }
 
    requestAnimationFrame(tick);
  }
 
  function boot() {
    ensureOverlayLayer();
    document.querySelectorAll('img').forEach(maybeAttach);
    startObserving();
 
    // UI events that almost always change occlusion within a frame. The
    // dirty flag lets the next occlusion pass bypass the idle throttle,
    // which is what makes pinned-message expand/collapse feel instant.
    // Scroll is included so emotes passing under a banner mid-scroll get
    // re-evaluated promptly, subject to OCCLUSION_DIRTY_MIN_INTERVAL_MS.
    document.addEventListener('click', markOcclusionDirty, { capture: true, passive: true });
    document.addEventListener('transitionend', markOcclusionDirty, { capture: true, passive: true });
    document.addEventListener('animationend', markOcclusionDirty, { capture: true, passive: true });
    window.addEventListener('resize', markOcclusionDirty, { passive: true });
    window.addEventListener('scroll', markOcclusionDirty, { capture: true, passive: true });
 
    requestAnimationFrame(tick);
  }
 
  document.body ? boot() : document.addEventListener('DOMContentLoaded', boot, { once: true });
})();
